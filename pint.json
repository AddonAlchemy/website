{
    "preset": "psr12",
    "rules": {
        "declare_strict_types": true,
        "ordered_imports": {
            "sort_algorithm": "alpha"
        },
        "no_unused_imports": true,
        "single_quote": true,
        "trailing_comma_in_multiline": true,
        "array_syntax": {
            "syntax": "short"
        },
        "concat_space": {
            "spacing": "none"
        },
        "not_operator_with_successor_space": true,
        "blank_line_before_statement": {
            "statements": ["return"]
        }
    },
    "exclude": [
        "bootstrap/cache",
        "storage"
    ]
}
